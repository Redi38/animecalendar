# Путь к файлу SQLite-кэша
DB_PATH=data/anime.db
LOG_LEVEL=INFO

# Каталог (структура, даты, связи между тайтлами)
ANILIST_URL=https://graphql.anilist.co
# Русские названия, описания и поиск кириллицей. false — показывать оригинальные названия
SHIKIMORI_BASE=https://shikimori.io
SHIKIMORI_ENABLED=true
HTTP_USER_AGENT=anime-calendar-ru/1.0

# За Caddy/nginx: брать IP клиента из X-Forwarded-For (для ограничения частоты запросов)
TRUST_PROXY_HEADERS=false

# Прогревать текущий и следующий сезон при старте
PREWARM=true

# Демо-режим: вымышленные тайтлы, без обращений к внешним API
DEMO_MODE=false

# Тайтлы 18+ и жанры, скрытые на Shikimori (яой, юри, хентай): поиск, загрузка списка просмотренного
# и связанные анонсы. Календарь сезонов остаётся без них. Включайте осознанно.
ALLOW_ADULT=false

# Кнопка «Смотреть онлайн» в карточке тайтла. {q} заменяется названием; пусто — кнопка скрыта.
# Внешний неофициальный сервис: при желании подставьте другой поисковый адрес.
WATCH_URL=https://old.yummyani.me/search?word={q}
